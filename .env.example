# Settings for docker compose. Copy to .env next to docker-compose.yaml:
#   cp .env.example .env
# then run scripts/secure-database.sh, which fills in MONGO_ROOT_PASS.
# (api/.env and web/.env hold the app settings; this file is for compose.)

# Database login. Required: compose refuses to start without a password.
MONGO_ROOT_USER=adminUser
MONGO_ROOT_PASS=

# Which network can reach the dashboard and API.
#   0.0.0.0        every network this computer is on (home Wi-Fi included)
#   100.x.y.z      only your NetBird (or Tailscale) network: use this
#                  computer's NetBird address, from `netbird status`
#   127.0.0.1      only this computer
BIND_ADDRESS=0.0.0.0

# Or per service, e.g. the dashboard only on NetBird while phones on your
# Wi-Fi still reach the API (it needs an API key either way):
# WEB_BIND_ADDRESS=100.x.y.z
# API_BIND_ADDRESS=0.0.0.0

# Ports on this computer.
WEB_PORT=3000
API_PORT=3001

# Database admin UI, started only on request:
#   docker compose --profile tools up -d mongo-express
# Listens on 127.0.0.1 only. Login: MONGO_EXPRESS_USER / MONGO_EXPRESS_PASS
# (the password defaults to MONGO_ROOT_PASS).
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=admin
# MONGO_EXPRESS_PASS=

# --- Single sign-on (Authentik or any OpenID Connect provider) -------------
# Read by both the API and the dashboard. See docs/SSO.md for the Authentik
# setup. Leave OIDC_ISSUER empty to keep email and password sign-in only.
#
# Issuer: Authentik shows it as "OpenID Configuration Issuer", e.g.
#   https://auth.example.com/application/o/crosshub/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Button label: "Continue with <name>".
OIDC_NAME=Authentik
# Only members of these groups may sign in (comma separated, optional).
OIDC_ALLOWED_GROUPS=
# Create a CrossHub account on someone's first sign-in (default true).
OIDC_ALLOW_SIGNUP=true
# Link to an existing account by email even if the provider does not mark
# the email as verified. Only for a provider you run yourself.
OIDC_TRUST_EMAIL=false

# Turn off email and password sign-in and sign-up, so single sign-on is the
# only way in. Ignored by the dashboard until OIDC_ISSUER is set, so you can't
# lock yourself out.
PASSWORD_LOGIN=true
ALLOW_REGISTRATION=true
